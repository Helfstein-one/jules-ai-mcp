# Google Jules API Key (gerada em jules.google > Settings > API Keys)
JULES_API_KEY=your_jules_api_key_here

# URL base da API do Jules (Padrão da API v1alpha / v1)
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha

# Configuração Opcional: Modo de Depuração / Sandbox (true para simular respostas em testes locais)
JULES_MOCK_MODE=false
